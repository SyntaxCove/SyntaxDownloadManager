{
  "name": "@syntaxdm/contracts",
  "version": "1.17.0",
  "private": true,
  "description": "Syntax Download Manager contract-first schemas: domain types, protocol envelopes, error codes. Single source of truth for the IPC and core boundaries.",
  "type": "module",
  "main": "./dist/index.js",
