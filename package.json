{
  "name": "syntax-download-manager",
  "version": "0.16.0",
  "private": true,
  "description": "Syntax Download Manager — unified browser + advanced download manager (Electron + Rust core)",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w @syntaxdm/contracts",
    "build:desktop": "npm run build -w @syntaxdm/desktop",
    "dist:win": "npm run build:desktop && npm run dist -w @syntaxdm/desktop",
    "test:core": "cargo test --manifest-path core/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "apps/desktop": {
    "version": "0.15.0"
  }
}
