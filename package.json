{
  "name": "unidm",
  "version": "0.5.0",
  "private": true,
  "description": "UniDM — unified browser + advanced download manager (Electron + Rust core)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w @unidm/contracts",
    "build:desktop": "npm run build -w @unidm/desktop",
    "test:core": "cargo test --manifest-path core/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
