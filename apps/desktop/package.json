{
  "name": "@unidm/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "UniDM desktop shell — Electron main, preload bridge, React renderer",
  "type": "commonjs",
  "main": "./dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.build-main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/preload/preload.cjs --sourcemap=external"
  },
  "dependencies": {
    "@unidm/contracts": "*",
    "lzma-native": "8.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar-stream": "3.2.2",
    "yauzl": "3.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@types/lzma-native": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yazl": "3.3.1"
  }
}
