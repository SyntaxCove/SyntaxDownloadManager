# Syntax Download Manager monorepo gitignore

node_modules/
dist/
out/
*.tsbuildinfo
.vite/

# Rust
core/target/
**/*.rs.bk

# Electron / packaging
apps/desktop/release/
apps/desktop/build/core/

# Local-only user uploads (may contain credentials — never commit)
upload/

# Runtime artifacts
*.log
userData/
db/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
tool-results/

# Sandbox-only (never part of the product)
skills/
tool-results/
download/
.env

# Stray core-database artifacts (the core's default SYNTAXDM_DB fallback name)
syntaxdm-core.db
syntaxdm-core.db-shm
syntaxdm-core.db-wal
*.db-wal
*.db-shm
